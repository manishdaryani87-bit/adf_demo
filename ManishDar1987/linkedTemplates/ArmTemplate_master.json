{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ManishDar1987"
		},
		"LS_SQL_SERVER_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQL_SERVER'"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://demodatabeliadls12.dfs.core.windows.net/"
		},
		"LS_SQL_SERVER_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "demo-databeli22.database.windows.net"
		},
		"LS_SQL_SERVER_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "demo_sql_db"
		},
		"LS_SQL_SERVER_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "databeli"
		},
		"TGR_Event_Simple_properties_PL_File_Event_parameters_file_name": {
			"type": "string",
			"defaultValue": "@triggerBody().fileName"
		},
		"TGR_Event_Simple_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/22386c9a-0f9c-4974-a87c-2aad17b29f6f/resourceGroups/Test/providers/Microsoft.Storage/storageAccounts/demodatabeliadls12"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ManishDar1987_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_SQL_SERVER_password": {
						"value": "[parameters('LS_SQL_SERVER_password')]"
					},
					"LS_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_properties_typeProperties_url')]"
					},
					"LS_SQL_SERVER_properties_typeProperties_server": {
						"value": "[parameters('LS_SQL_SERVER_properties_typeProperties_server')]"
					},
					"LS_SQL_SERVER_properties_typeProperties_database": {
						"value": "[parameters('LS_SQL_SERVER_properties_typeProperties_database')]"
					},
					"LS_SQL_SERVER_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQL_SERVER_properties_typeProperties_userName')]"
					},
					"TGR_Event_Simple_properties_PL_File_Event_parameters_file_name": {
						"value": "[parameters('TGR_Event_Simple_properties_PL_File_Event_parameters_file_name')]"
					},
					"TGR_Event_Simple_properties_typeProperties_scope": {
						"value": "[parameters('TGR_Event_Simple_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}